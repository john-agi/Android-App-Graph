{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "forkProcessing": "enabled",
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-3 * * 1"]
  }
}

# Copy to .env and source it before running commands; never commit credentials.
OPENROUTER_API_KEY=

APP_GRAPH_PAGE_DETAIL_MODEL=openai/gpt-6.1-sol
APP_GRAPH_PAGE_DETAIL_BASE_URL=https://openrouter.ai/api/v1
APP_GRAPH_PAGE_DETAIL_API_KEY=${OPENROUTER_API_KEY}

APP_GRAPH_EMBEDDING_MODEL=google/gemini-embedding-2
APP_GRAPH_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
APP_GRAPH_EMBEDDING_API_KEY=${OPENROUTER_API_KEY}

APP_GRAPH_INSTRUCTION_MODEL=openai/gpt-6.1-sol
APP_GRAPH_INSTRUCTION_BASE_URL=https://openrouter.ai/api/v1
APP_GRAPH_INSTRUCTION_API_KEY=${OPENROUTER_API_KEY}

APP_GRAPH_ACTION_MODEL=qwen/qwen3.8-flash
APP_GRAPH_ACTION_BASE_URL=https://openrouter.ai/api/v1
APP_GRAPH_ACTION_API_KEY=${OPENROUTER_API_KEY}

# Copy this file to .env and fill in your provider credentials.
# Never commit .env.

UI_KOBE_PAGE_DETAIL_MODEL=gpt-5.4
UI_KOBE_PAGE_DETAIL_BASE_URL=https://api.openai.com/v1
UI_KOBE_PAGE_DETAIL_API_KEY=

UI_KOBE_EMBEDDING_MODEL=gemini-embedding-2-preview
UI_KOBE_EMBEDDING_BASE_URL=https://api.openai.com/v1
UI_KOBE_EMBEDDING_API_KEY=

UI_KOBE_INSTRUCTION_MODEL=gpt-5.4
UI_KOBE_INSTRUCTION_BASE_URL=https://api.openai.com/v1
UI_KOBE_INSTRUCTION_API_KEY=

UI_KOBE_ACTION_MODEL=qwen3.5-plus-2026-02-15
UI_KOBE_ACTION_BASE_URL=https://api.openai.com/v1
UI_KOBE_ACTION_API_KEY=

# Optional, used by the v2 runtime for native Gemini image embeddings.
GEMINI_API_KEY=
